{
  "name": "taskapp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Trello-style Kanban task manager: React frontend + Node API, run together from one terminal.",
  "engines": { "node": ">=22.13" },
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w client",
    "start": "NODE_ENV=production npm start -w server",
    "test": "npm test -w server",
    "lint": "npm run lint -w client",
    "check": "node scripts/check-secrets.mjs && node scripts/check-contrast.mjs && node scripts/check-images.mjs && node scripts/check-links.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:images": "node scripts/check-images.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "lighthouse": "npx --yes @lhci/cli@0.14 autorun",
    "images": "node scripts/generate-images.mjs"
  }
}
