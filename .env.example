# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# ---------- Server-only secrets (never exposed to the browser) ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
PORT=4000
# SQLite database file (created automatically)
DATABASE_FILE=./server/data/taskapp.db
# Folder for card attachments (created automatically) and the per-file size limit in MB
UPLOAD_DIR=./server/data/uploads
MAX_UPLOAD_MB=10
# In production HTTP is redirected to HTTPS. Set to false only for local production smoke tests.
FORCE_HTTPS=true

# ---------- Email (password reset links) ----------
# Without SMTP_HOST, emails are printed to the server console instead (fine for development).
# Hostinger: smtp.hostinger.com, port 465, your full mailbox address and its password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Sender shown to users, e.g. TaskApp <no-reply@yourdomain.com> (must be allowed by your mail provider)
MAIL_FROM=
# Base URL for links in emails. Defaults to VITE_PUBLIC_SITE_URL.
SITE_URL=

# ---------- Public values (bundled into the frontend, NOT secret) ----------
# Only variables starting with VITE_PUBLIC_ reach browser code.
VITE_PUBLIC_SITE_URL=http://localhost:5173
# Your site's domain in Plausible Analytics. Leave empty to disable analytics.
VITE_PUBLIC_PLAUSIBLE_DOMAIN=
