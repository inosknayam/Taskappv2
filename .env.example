# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# ---------- Server-only secrets (never exposed to the browser) ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
PORT=4000
# SQLite database file (created automatically)
DATABASE_FILE=./server/data/taskapp.db
# In production HTTP is redirected to HTTPS. Set to false only for local production smoke tests.
FORCE_HTTPS=true

# ---------- Public values (bundled into the frontend, NOT secret) ----------
# Only variables starting with VITE_PUBLIC_ reach browser code.
VITE_PUBLIC_SITE_URL=http://localhost:5173
# Your site's domain in Plausible Analytics. Leave empty to disable analytics.
VITE_PUBLIC_PLAUSIBLE_DOMAIN=
